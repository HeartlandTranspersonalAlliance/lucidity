# This file contains identifiers and configuration only. Do not add credentials.
aws_region = "us-east-2"

# Monitoring-only AWS Budgets alerts are free and cover the complete account so that
# untagged cost leaks are visible. Review the limit and email before enabling.
enable_account_cost_budget = false
account_annual_cost_limit_usd = 1100
# account_cost_budget_notification_email = "operations@example.org"

# Apply only ECR, GitHub OIDC, and disposable AMI snapshot validation initially.
enable_network         = false
enable_runtime_secrets = false
enable_instance_management = false
enable_ami_launch_validation = false
enable_ec2_launch_templates  = false
enable_ec2_instances         = false
enable_cloudflare_dns        = false
enable_node_backups          = false
enable_node_monitoring       = false

# After both roles have retained, boot-validated AMIs and the controller secret has
# been populated out of band, enable networking, instance management, runtime secrets,
# and launch templates together. Pin exact AMI IDs; never select "newest".
# controller_ami_id = "ami-0123456789abcdef0"
# worker_ami_id     = "ami-0fedcba9876543210"
# enable_ec2_launch_templates = true
# enable_ec2_instances        = true
# cloudflare_zone_id          = "0123456789abcdef0123456789abcdef"
# enable_cloudflare_dns       = true
# enable_node_backups         = true
# enable_node_monitoring      = true
# node_alarm_notification_email = "operations@example.org"

# Both nodes default to the first selected public subnet to avoid cross-AZ traffic.
# Override either index to spread nodes after accepting the availability and transfer trade-off.
ec2_node_availability_zone_indices = {
  controller = 0
  worker     = 0
}

# Direct API termination protection is enabled by default. OpenTofu changes can still
# replace resources, so review every production plan and back up mutable state first.
enable_ec2_termination_protection = true

# AWS Backup stores crash-consistent recovery points for both nodes every day
# at 05:00 UTC. The cost-conscious default retains 14 days of incremental changes.
node_backup_retention_days = 14

controller_root_volume_size_gib = 40
worker_root_volume_size_gib     = 80

# A deleted controller runtime secret remains recoverable for 30 days.
secret_recovery_window_in_days = 30

# When enable_network is later set, the public-instance design still needs no NAT Gateways.
enable_nat_gateways = false

# For one merged-main AMI boot test, enable networking, instance management, and
# this flag together. Disable this flag again after the disposable test passes.

github_repository     = "HeartlandTranspersonalAlliance/lucidity"
github_publish_branch = "main"
# Immutable GitHub identity values are defined as validated defaults in variables.tf.
# Confirm them with `gh api repos/OWNER/REPO` after a repository transfer.

# Set this when the AWS account already has the account-level GitHub provider.
# github_oidc_provider_arn = "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"

tags = {
  Environment = "production"
}
