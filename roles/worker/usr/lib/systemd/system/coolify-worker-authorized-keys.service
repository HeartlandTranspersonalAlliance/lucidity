[Unit]
Description=Install runtime-provisioned Coolify worker SSH keys
Documentation=https://github.com/HeartlandTranspersonalAlliance/lucidity
Wants=cloud-final.service
After=cloud-final.service
ConditionPathExists=/etc/coolify-worker/authorized_keys

[Service]
Type=oneshot
ExecStart=/usr/libexec/coolify-aws/bootstrap-worker --authorized-key-file /etc/coolify-worker/authorized_keys
RemainAfterExit=yes

[Install]
WantedBy=cloud-init.target
