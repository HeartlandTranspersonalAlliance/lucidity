[Unit]
Description=Initialize the AWS Workload Credentials Provider SSRF token
Before=aws-workload-credentials-provider-sm.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/coolify-aws/workload-credentials-provider-token start
ExecStop=/usr/libexec/coolify-aws/workload-credentials-provider-token stop

[Install]
WantedBy=multi-user.target
