#!/usr/bin/env bash
set -Eeuo pipefail

bootstrap=${COOLIFY_BOOTSTRAP_BIN:-/usr/libexec/coolify-aws/bootstrap-controller}
reference_file=${COOLIFY_RUNTIME_SECRETS_FILE:-/etc/coolify-controller/runtime-secrets.env}
secret_variables=(
    COOLIFY_APP_ID
    COOLIFY_APP_KEY
    COOLIFY_DB_PASSWORD
    COOLIFY_REDIS_PASSWORD
    COOLIFY_PUSHER_APP_ID
    COOLIFY_PUSHER_APP_KEY
    COOLIFY_PUSHER_APP_SECRET
)

if [[ ! -e ${reference_file} ]]; then
    exec "${bootstrap}"
fi

for variable in "${secret_variables[@]}"; do
    value=${!variable:-}
    if [[ -z ${value} ]]; then
        echo "${reference_file} must define ${variable}" >&2
        exit 1
    fi
    if [[ ! ${value} =~ ^\{\{resolve:secretsmanager:.+:SecretString:[^}:]+(:AWSCURRENT)?\}\}$ ]]; then
        echo "${reference_file} must contain only Secrets Manager dynamic references" >&2
        exit 1
    fi
done

token_file=${AWS_WCP_TOKEN_FILE:-/run/awssmatoken}
[[ -r ${token_file} ]] || { echo "AWS workload credentials token is unavailable" >&2; exit 1; }
IFS= read -r token <"${token_file}"
[[ -n ${token} ]] || { echo "AWS workload credentials token is empty" >&2; exit 1; }

AWS_TOKEN=${token} exec "${ASM_EXEC_BIN:-/usr/bin/asm-exec}" -- \
    env -u AWS_TOKEN "${bootstrap}"
