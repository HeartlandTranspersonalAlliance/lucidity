#!/usr/bin/env bash
set -Eeuo pipefail

: "${AWS_MOCK_LOG:?AWS_MOCK_LOG is required}"
: "${AWS_MOCK_SNAPSHOT_ID:=snap-123abc}"
: "${AWS_MOCK_KMS_KEY_ARN:=arn:aws:kms:us-east-2:123456789012:key/11111111-2222-3333-4444-555555555555}"
printf '%s\n' "$*" >> "${AWS_MOCK_LOG}"

service=${1:-}
operation=${2:-}

case "${service} ${operation}" in
    "s3 cp"|"s3 rm"|"ec2 create-tags"|"ec2 deregister-image"|"ec2 delete-snapshot")
        ;;
    "ec2 import-snapshot")
        printf '%s\n' '{"ImportTaskId":"import-snap-test"}'
        ;;
    "ec2 describe-import-snapshot-tasks")
        jq -cn --arg snapshot_id "${AWS_MOCK_SNAPSHOT_ID}" \
            '{ImportSnapshotTasks:[{ImportTaskId:"import-snap-test",SnapshotTaskDetail:{Status:"completed",Progress:"100",SnapshotId:$snapshot_id}}]}'
        ;;
    "ec2 describe-snapshots")
        if [[ " $* " == *" --owner-ids self "* ]]; then
            printf '%s\n' "${AWS_MOCK_SNAPSHOT_ID}"
        else
            jq -cn \
                --arg kms_key_id "${AWS_MOCK_KMS_KEY_ARN}" \
                --arg snapshot_id "${AWS_MOCK_SNAPSHOT_ID}" \
                '{Snapshots:[{SnapshotId:$snapshot_id,Encrypted:true,KmsKeyId:$kms_key_id,State:"completed",VolumeSize:12}]}'
        fi
        ;;
    "ec2 register-image")
        printf '%s\n' '{"ImageId":"ami-test"}'
        ;;
    "ec2 wait")
        ;;
    "ec2 describe-images")
        if [[ " $* " == *" --owners self "* && ${AWS_MOCK_EXISTING_AMI:-false} != true ]]; then
            printf '%s\n' '{"Images":[]}'
        else
            image_id=ami-test
            [[ " $* " == *" --owners self "* ]] && image_id=ami-abc123
            jq -cn --arg image_id "${image_id}" --arg snapshot_id "${AWS_MOCK_SNAPSHOT_ID}" \
                '{Images:[{ImageId:$image_id,State:"available",Architecture:"x86_64",RootDeviceType:"ebs",BootMode:"uefi",EnaSupport:true,ImdsSupport:"v2.0",BlockDeviceMappings:[{DeviceName:"/dev/xvda",Ebs:{SnapshotId:$snapshot_id,DeleteOnTermination:true,VolumeType:"gp3"}}]}]}'
        fi
        ;;
    "ec2 describe-security-groups")
        printf '%s\n' '{"SecurityGroups":[{"GroupId":"sg-test","IpPermissions":[{"IpProtocol":"tcp","FromPort":22,"ToPort":22,"IpRanges":[],"Ipv6Ranges":[],"UserIdGroupPairs":[{"GroupId":"sg-controller"}]}]}]}'
        ;;
    "ec2 run-instances")
        printf '%s\n' '{"Instances":[{"InstanceId":"i-test"}]}'
        ;;
    "ec2 describe-instances")
        printf '%s\n' 'running'
        ;;
    "ec2 terminate-instances")
        printf '%s\n' '{}'
        ;;
    "ssm describe-instance-information")
        printf '%s\n' 'Online'
        ;;
    "ssm send-command")
        printf '%s\n' '{"Command":{"CommandId":"command-test"}}'
        ;;
    "ssm get-command-invocation")
        printf '%s\n' '{"Status":"Success","StandardOutputContent":"mock guest validation passed","StandardErrorContent":""}'
        ;;
    *)
        echo "unsupported mocked AWS operation: ${service} ${operation}" >&2
        exit 1
        ;;
esac
