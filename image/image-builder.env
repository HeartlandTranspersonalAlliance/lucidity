# Upstream unified image-builder, pinned to the multi-architecture index digest
# verified on 2026-08-14. Dependabot does not update arbitrary container refs;
# update this deliberately after reviewing upstream release notes and rebuilding.
IMAGE_BUILDER_IMAGE=ghcr.io/osbuild/image-builder-cli@sha256:27cabea9e504a7c4a7546f287f5d60a4846c62b5a8d18c0f678d25fdc2d7975a

# Keep the artifact modest; Terraform can request a larger encrypted gp3 root
# volume and cloud-init grows the filesystem on first boot.
IMAGE_SIZE_GIB=10
IMAGE_ROOT_FS=xfs
